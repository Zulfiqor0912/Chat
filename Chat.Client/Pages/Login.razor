@page "/login"
@using System.Net
@using Chat.Client.Models
@inject HttpClient Client
@inject NavigationManager Manager

<h3>Login</h3>

<form>
    <div>
        <label>Username</label>
        <InputText @bind-Value="@_model.Username"></InputText>
    </div>
    <br/>
    <div>
        <label>Password</label>
        <InputText @bind-Value="@_model.Passwor"></InputText>
    </div>
    
    <button type="button" class="btn-primary" @onclick="LoginClicked">Login</button>
</form>

@code {
    private LoginModel _model = new();
    private string? response { get; set; }

    private async Task LoginClicked()
    {
        string url = "https://localhost:7109/api/Users/login";
        var result = await Client.PostAsJsonAsync(url, _model);

        var response = await result.Content.ReadAsStringAsync();

        var isOk = result.StatusCode == HttpStatusCode.OK;
        var isBadRequest = result.StatusCode == HttpStatusCode.BadRequest;

        if (isOk) Manager.NavigateTo($"/login-successfully/{response}");
        else if (isBadRequest) Manager.NavigateTo($"/error/{response}");

    }

}